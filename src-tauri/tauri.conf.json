{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Downloader",
  "version": "1.0.0",
  "identifier": "com.kai.universaldownloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Universal Downloader",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.open-meteo.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "m3u",
          "m3u8"
        ],
        "name": "Playlist",
        "description": "Media playlist containing links",
        "role": "Viewer"
      }
    ],
    "publisher": "Kai",
    "copyright": "\u00a9 2026 Kai. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Download media from the web.",
    "longDescription": "Universal Downloader is a fast, minimal desktop app for downloading video and audio from the web. Paste a link to fetch rich metadata, pick a format and quality, and download \u2014 with a queue, live progress, history and sensible defaults. Powered by yt-dlp and ffmpeg under the hood.",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}